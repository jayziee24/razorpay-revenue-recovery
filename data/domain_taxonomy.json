  "error_object_schema": {
    "fields": [
      "code",
      "description",
      "field",
      "source",
      "step",
      "reason",
      "metadata"
    ],
    "source_values": [
      "customer",
      "bank",
      "business",
      "internal",
      "gateway",
      "issuer_bank"
    ]
  },
  "mandate_rules": {
    "retry_cap": {
      "max_attempts_per_cycle": 4,
      "description": "1 original + 3 retries max (NPCI, tightened Aug 2025). After exhaustion, hard stop, must escalate."
    },
    "afa_thresholds": {
      "standard_afa_free_limit_inr": 15000,
      "extended_afa_free_limit_inr": 100000,
      "extended_categories": [
        "credit_card_bills",
        "mutual_funds",
        "insurance",
        "loan_emi"
      ],
      "description": "Debits above applicable threshold require Additional Factor Authentication; agent cannot silently auto-charge."
    },
    "pre_debit_notification": {
      "required_hours_before_debit": 24,
      "mandatory": true
    },
    "retry_spacing": {
      "recommended_windows_hours": [24, 72, 168],
      "description": "Retries should be spaced (not rapid-fire) to align with likely salary-credit timing and avoid NPCI spam flags."
    },
    "mandate_states": [
      "created",
      "authorized",
      "active",
      "paused",
      "revoked",
      "expired"
    ],
    "debit_states": ["debit_success", "debit_failure"],
    "terminal_states_no_retry": ["revoked", "expired"]
  },
  "loss_categories": [
    "payment_degradation",
    "checkout_dropoff",
    "subscription_fail",
    "mandate_retry",
    "receivable_overdue",
    "promise_to_pay"
  ]
}
